boot_script = "core/game/boot"
boot_package = "boot"
window_title = "04-vehicle"

render_settings = {
	msaa = true
}

android = {
	render_settings = {
		msaa_quality = "low"
		render_scale = 0.5
		sun_shadow_map_size = [ 1024 1024 ]
		sun_shadow_map_quality = "low"
		local_lights_shadow_map_size = [ 1024 1024 ]
		local_lights_shadow_map_quality = "low"
	}
}

html5 = {
	renderer = {
		fullscreen = true
	}
}

linux = {
	renderer = {
		resolution = [ 1280 720 ]
		vsync = true
	}
}
windows = {
	renderer = {
		resolution = [ 1280 720 ]
		vsync = true
	}
}
