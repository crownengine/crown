render_settings = {
	// Whether shadows for the sun are enabled.
	// sun_shadows = true
	// sun_shadow_map_size = [ 4096 4096 ]
	// low, medium, high or ultra (hard, 4, 9 or 16 taps respectively).
	// sun_shadow_map_quality = "ultra"
	// Weight of logarithmic sun shadow split distribution in the 0..1 range.
	// 0 produces evenly spaced splits; 1 concentrates splits near the camera.
	// sun_shadow_split_weight = 0.75
	// Fraction of a sun shadow split that overlaps the next.
	// sun_shadow_split_overlap = 0.005
	// Maximum distance the shadow caster region extends from each cascade toward the sun.
	// sun_shadow_max_caster_distance = 250
	// Whether contribution culling for visible objects is enabled.
	// object_contribution_culling = false
	// Whether contribution culling for sun shadows is enabled.
	// sun_shadow_contribution_culling = true
	// Objects whose projected width and height are both smaller than this are culled.
	// object_contribution_culling_min_screen_size = 1.5
	// Shadow casters whose projected width and height are both smaller than this are culled.
	// sun_shadow_contribution_culling_min_screen_size = 4

	// Whether local lights are enabled.
	// local_lights = true

	// Whether shadows for local lights are enabled.
	// local_lights_shadows = true
	// local_lights_shadow_map_size = [ 2048 2048 ]
	// low, medium, high or ultra (hard, 4, 9 or 16 taps respectively).
	// local_lights_shadow_map_quality = "ultra"

	// Whether distance culling for local lights is enabled.
	// local_lights_distance_culling = false

	// Distance from camera at which local lights start to fade.
	// local_lights_distance_culling_fade = 30
	// Distance from camera at which local lights disappear.
	// local_lights_distance_culling_cutoff = 60

	// Duration in seconds of LOD crossfades.
	// lod_fade_duration = 0.2

	// Whether bloom post-processing effect is enabled.
	// bloom = true

	// Whether multisample AA is enabled.
	// msaa = false
	// low, medium, high or ultra (2, 4, 8 or 16x respectively).
	// msaa_quality = "ultra"

	// Whether selection rendering is enabled.
	// selection = false
}

// Shader libraries to load at boot.
shaders = [
	"core/shaders/default"
	"core/shaders/shadow_map"
	"core/shaders/post_processing"
	"core/shaders/editor"
]
